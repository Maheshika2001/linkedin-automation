<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="LinkedIn UI Suite" verbose="1">
  <listeners>
    <listener class-name="com.sqa.linkedin.listeners.ScreenshotListener"/>
  </listeners>
  <test name="LinkedIn flows">
    <classes>
      <class name="com.sqa.linkedin.tests.LoginTest"/>
      <class name="com.sqa.linkedin.tests.SearchTest"/>
      <class name="com.sqa.linkedin.tests.OpenResultTest"/>
    </classes>
  </test>
</suite>
